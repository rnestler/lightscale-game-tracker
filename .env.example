DB_NAME="gamerank_tracker"
DB_USER="gamerank_tracker_user"
DB_PASSWORD=""
DB_HOST="localhost"
DB_PORT="5432"
DATABASE_URL="postgres://gamerank_tracker_user:@localhost:5432/gamerank_tracker"
# Used only by setup:db, to create DB_NAME/DB_USER on a fresh install
DB_ADMIN_USER="postgres"
DB_ADMIN_PASSWORD=""
DB_ADMIN_DATABASE="postgres"
BETTER_AUTH_SECRET=""
# Address users reach the software at; the public https address in production
BETTER_AUTH_URL="http://localhost:3500"
PORT=3500
# Origin of the development frontend; empty in production, where the backend serves the frontend itself
CORS_ORIGIN="http://localhost:4500"
# Behind a reverse proxy set this to the number of proxies in front of the backend (usually 1) so rate limits see the client address
TRUST_PROXY=""
VITE_BACKEND_PORT=3500
VITE_FRONTEND_PORT=4500
# Public address of the backend when a production frontend is served from another origin, for example https://api.example.com; empty when both share one origin and in development
VITE_API_URL=""

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# Email delivery — fill in your SMTP credentials to send verification, password reset and invitation emails
# Without them the software keeps working and prints every link to the backend log instead
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Social login — fill in your OAuth credentials to enable Google/Apple/Microsoft sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Currency every money amount is shown in, as an ISO 4217 code; rebuild the frontend after a change
VITE_CURRENCY="USD"
