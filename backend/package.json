{
  "name": "gamerank-tracker-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch --watch-preserve-output src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "setup:auth": "tsx src/scripts/setup-auth.ts",
    "check": "tsc --noEmit && eslint src",
    "format": "prettier --write \"src/**/*.ts\" --config .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.ts\" --config .prettierrc.json"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.4",
    "better-auth": "1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "markdown-it": "^15.0.2",
    "nodemailer": "^10.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
